{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Firmware",
            "type": "shell",
            "command": "cmake -B build . && cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Simulation",
            "type": "shell",
            "command": "renode sim/setup.resc",
            "dependsOn": "Build Firmware",
            "problemMatcher": []
        }
    ]
}